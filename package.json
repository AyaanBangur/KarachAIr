{
  "name": "karachair",
  "private": true,
  "version": "0.1.0",
  "description": "KarachAir — extreme-heat intelligence for Karachi, built on open satellite, population and climate data.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "data": "node scripts/pipeline/run.mjs",
    "data:static": "node scripts/pipeline/run.mjs --skip-modis",
    "test": "vitest run",
    "eval": "node scripts/run-eval.mjs",
    "findings": "node scripts/run-eval.mjs scripts/findings.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.2.0",
    "@fontsource-variable/geist-mono": "^5.2.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/instrument-serif": "^5.2.0",
    "leaflet": "^1.9.4",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "geotiff": "^2.1.3",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  }
}
