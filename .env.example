# Copy to .env.local and fill in. Without these, the Volunteer tab still works but logs stay on each device.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Optional "Whisper Flow" voice cleaning with an LLM (Groq, Llama 3). Server-side only: no VITE_ prefix. Without it the app uses its built-in cleaner.
GROQ_API_KEY=
